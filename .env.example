# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_STREAMING_API_BASE: Base URL for the anime streaming metadata/watch provider.
VITE_STREAMING_API_BASE="https://ashanime-api.vercel.app"

# VITE_ANILIST_API_URL: AniList GraphQL endpoint for anime metadata, search, and schedules.
VITE_ANILIST_API_URL="https://graphql.anilist.co"

# ADMIN_EMAIL: Server-side single authorized administrator email.
ADMIN_EMAIL="amd712785@gmail.com"

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional server-only Firebase Admin service account JSON string for custom claims & revocation checks.
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# FIREBASE_CONFIG_JSON: Optional server-only fallback JSON if firebase-applet-config.json is omitted in external hosts.
# FIREBASE_CONFIG_JSON=""

# ANIMEWORLD_UPSTREAM_URL: Optional override for the AnimeWorld-India upstream base URL (defaults to https://animesky.app).
# ANIMEWORLD_UPSTREAM_URL="https://animesky.app"

# VITE_BACKEND_API_URL: Deployed backend origin used by Capacitor Android builds when resolving /api/* routes (defaults to https://animeworldbd.vercel.app).
# VITE_BACKEND_API_URL="https://animeworldbd.vercel.app"

# CONSUMET_API_URL: Consumet API backend base URL used by the separate Munchyroll streaming server.
# Note: Munchyroll's original https://consumet-public.vercel.app is disabled (HTTP 402); set this to a live self-hosted Consumet instance.
CONSUMET_API_URL="https://consumet-public.vercel.app"

# VITE_CONSUMET_API_URL: Optional client-side default Consumet API URL override for Munchyroll.
# VITE_CONSUMET_API_URL="https://your-consumet-instance.example.com"

# CORS_PROXY_URL: Optional cors-anywhere proxy URL if proxying external Munchyroll assets outside /api/anime/proxy.
# CORS_PROXY_URL=""
