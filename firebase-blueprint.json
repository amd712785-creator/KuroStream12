{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user streaming preferences, profile display info, and activity timestamps.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "bannerURL": {
          "type": "string",
          "maxLength": 500
        },
        "preferredAudio": {
          "type": "string",
          "enum": ["sub", "dub", "hindi"]
        },
        "autoNext": {
          "type": "boolean"
        },
        "lastActiveDay": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "theme": {
          "type": "string",
          "enum": ["midnight-purple", "deep-black", "ocean-blue", "crimson-red", "emerald-green", "rose-pink", "amoled-black"]
        },
        "streakCurrent": {
          "type": "number",
          "minimum": 0
        },
        "streakLongest": {
          "type": "number",
          "minimum": 0
        },
        "streakLastWatchedDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "streakWatchedDays": {
          "type": "array",
          "items": { "type": "string", "maxLength": 10 },
          "maxItems": 400
        },
        "totalEpisodesCompleted": {
          "type": "number",
          "minimum": 0
        },
        "todayEpisodesCompleted": {
          "type": "number",
          "minimum": 0
        },
        "todayCompletedDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "totalWatchSeconds": {
          "type": "number",
          "minimum": 0
        },
        "todayWatchSeconds": {
          "type": "number",
          "minimum": 0
        },
        "todayWatchDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "watchedAnimeIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 120 },
          "maxItems": 500
        },
        "unlockedAchievements": {
          "type": "array",
          "items": { "type": "string", "maxLength": 40 },
          "maxItems": 30
        },
        "achievementUnlockDates": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 40 }
        },
        "equippedBadges": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "first_watch",
              "streak_3",
              "streak_7",
              "streak_30",
              "streak_100",
              "anime_explorer",
              "anime_master",
              "anime_legend",
              "binge_watcher",
              "marathon_legend"
            ],
            "maxLength": 40
          },
          "maxItems": 5
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "preferredAudio", "autoNext", "createdAt", "updatedAt"]
    },
    "ProfileBanner": {
      "title": "ProfileBanner",
      "description": "Admin-managed and unlockable profile header banner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "enabled": {
          "type": "boolean"
        },
        "isLocked": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "imageUrl",
        "enabled",
        "isLocked",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomizationSettings": {
      "title": "CustomizationSettings",
      "description": "Global unlock settings for profile banners and avatars.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["global"]
        },
        "globalBannersUnlocked": {
          "type": "boolean"
        },
        "globalAvatarsUnlocked": {
          "type": "boolean"
        },
        "lockedBannerIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "maxItems": 500
        },
        "lockedAvatarIds": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "maxItems": 500
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "globalBannersUnlocked",
        "globalAvatarsUnlocked",
        "lockedBannerIds",
        "lockedAvatarIds",
        "updatedBy",
        "updatedAt"
      ]
    },
    "PopupBanner": {
      "title": "PopupBanner",
      "description": "Admin-managed promotional or announcement popup banner shown on KuroStream.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "buttonText": {
          "type": "string",
          "maxLength": 60
        },
        "destinationUrl": {
          "type": "string",
          "maxLength": 500
        },
        "openInNewTab": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "startAt": {
          "type": "string",
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 40
        },
        "frequency": {
          "type": "string",
          "enum": ["once_per_session", "once_per_day", "once_per_user", "always_on_launch"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "imageUrl",
        "openInNewTab",
        "enabled",
        "frequency",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "Anime saved to a user watchlist.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animeId": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "coverImage": {
          "type": "string",
          "maxLength": 500
        },
        "format": {
          "type": "string",
          "maxLength": 40
        },
        "episodes": {
          "type": "number"
        },
        "averageScore": {
          "type": "number"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "animeId", "title", "coverImage", "addedAt"]
    },
    "FavoriteItem": {
      "title": "FavoriteItem",
      "description": "Anime marked as favorite by a user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animeId": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "coverImage": {
          "type": "string",
          "maxLength": 500
        },
        "format": {
          "type": "string",
          "maxLength": 40
        },
        "averageScore": {
          "type": "number"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "animeId", "title", "coverImage", "addedAt"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "User watch history and episode playback progress.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animeId": {
          "type": "number"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "coverImage": {
          "type": "string",
          "maxLength": 500
        },
        "episodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "episodeNumber": {
          "type": "number"
        },
        "episodeTitle": {
          "type": "string",
          "maxLength": 240
        },
        "progressSeconds": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "number"
        },
        "audioMode": {
          "type": "string",
          "enum": ["sub", "dub", "hindi"]
        },
        "serverName": {
          "type": "string",
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "animeId",
        "title",
        "coverImage",
        "episodeId",
        "episodeNumber",
        "progressSeconds",
        "durationSeconds",
        "audioMode",
        "updatedAt"
      ]
    },
    "WatchActivityMonth": {
      "title": "WatchActivityMonth",
      "description": "Per-month daily playback seconds for the Daily Watch Activity Calendar.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "days": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "monthKey", "days", "updatedAt"]
    },
    "AppUpdate": {
      "title": "AppUpdate",
      "description": "Admin-controlled KuroStream Android APK update configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["latest"]
        },
        "enabled": {
          "type": "boolean"
        },
        "latestVersion": {
          "type": "string",
          "maxLength": 40
        },
        "versionCode": {
          "type": "number",
          "minimum": 1
        },
        "apkUrl": {
          "type": "string",
          "maxLength": 500
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "releaseNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "buttonText": {
          "type": "string",
          "maxLength": 60
        },
        "mandatory": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "enabled", "latestVersion", "versionCode", "apkUrl", "title", "mandatory", "updatedAt"]
    },
    "ActiveSession": {
      "title": "ActiveSession",
      "description": "Real-time user watch session heartbeat for Currently Watching feature.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "userAvatar": { "type": "string", "maxLength": 500 },
        "animeId": { "type": "number" },
        "animeTitle": { "type": "string", "maxLength": 240 },
        "episodeNumber": { "type": "number" },
        "episodeTitle": { "type": "string", "maxLength": 240 },
        "serverName": { "type": "string", "maxLength": 60 },
        "progressSeconds": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "animeId", "animeTitle", "episodeNumber", "serverName", "updatedAt"]
    }
  },
  "firestore": {
    "/active_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ActiveSession" },
      "description": "Active user watch playback sessions for live monitoring."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User streaming profile, playback preferences, and real activity timestamps."
    },
    "/users/{userId}/watchlist/{animeId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "User saved anime watchlist subcollection."
    },
    "/users/{userId}/favorites/{animeId}": {
      "schema": { "$ref": "#/entities/FavoriteItem" },
      "description": "User favorite anime subcollection."
    },
    "/users/{userId}/history/{animeId}": {
      "schema": { "$ref": "#/entities/HistoryItem" },
      "description": "User watch history and continue-watching progress subcollection."
    },
    "/users/{userId}/watchActivity/{monthKey}": {
      "schema": { "$ref": "#/entities/WatchActivityMonth" },
      "description": "User monthly daily watch duration subcollection."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/PopupBanner" },
      "description": "Admin-managed popup banners."
    },
    "/profile_banners/{bannerId}": {
      "schema": { "$ref": "#/entities/ProfileBanner" },
      "description": "Admin-managed and unlockable profile header banners."
    },
    "/customization_settings/{settingId}": {
      "schema": { "$ref": "#/entities/CustomizationSettings" },
      "description": "Global customization unlock settings."
    },
    "/app_updates/{updateId}": {
      "schema": { "$ref": "#/entities/AppUpdate" },
      "description": "Admin-controlled KuroStream Android APK update configuration."
    }
  }
}
